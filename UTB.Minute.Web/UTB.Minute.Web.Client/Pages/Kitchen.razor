@page "/kitchen"
@attribute [Authorize(Roles = "canteen-cook")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using UTB.Minute.Contracts
@using System.Net.Http.Json
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory

<h3 class="mb-4">Kuchyně - Aktivní objednávky</h3>

@if (_orders == null)
{
    <div class="d-flex align-items-center">
        <strong role="status">Načítání objednávek a připojování k systému...</strong>
        <div class="spinner-border ms-auto" aria-hidden="true"></div>
    </div>
}
else if (!_orders.Any())
{
    <div class="alert alert-info">Momentálně nejsou žádné aktivní objednávky k přípravě.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var order in _orders)
        {
            <div class="col">
                <div class="card h-100 shadow-sm @GetCardBorderClass(order.State)">
                    <div class="card-header d-flex justify-content-between align-content-center">
                        <span class="fw-bold">Objednávka #@order.Id.ToString().Substring(0, 8)</span>
                        <span class="badge @GetBadgeClass(order.State)">@TranslateState(order.State)</span>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">@GetMealName(order.MenuItemId)</h5>
                        <p class="card-text text-muted">ID studenta: @order.StudentId</p>
                    </div>
                    <div class="card-footer d-flex gap-2">
                        @if (order.State == OrderStateDto.Preparing)
                        {
                            <button class="btn btn-success btn-sm w-100" @onclick="() => UpdateState(order.Id, OrderStateDto.Ready)">
                                Hotovo k vydání
                            </button>
                        }
                        @if (order.State == OrderStateDto.Ready)
                        {
                            <button class="btn btn-primary btn-sm w-100" @onclick="() => UpdateState(order.Id, OrderStateDto.Completed)">
                                Vydat jídlo
                            </button>
                        }
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => UpdateState(order.Id, OrderStateDto.Cancelled)">
                            Zrušit
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<OrderDto>? _orders;
    private Dictionary<Guid, string> _mealNamesCache = new();
    private CancellationTokenSource? _sseCts;
    private HttpClient? _apiClient;
    private bool _sseConnected = false;

    protected override async Task OnInitializedAsync()
    {
        _apiClient = HttpClientFactory.CreateClient("webapi");

        try
        {
            var menuItems = await _apiClient.GetFromJsonAsync<MenuItemDto[]>("/menu");
            if (menuItems != null)
            {
                _mealNamesCache = menuItems.ToDictionary(m => m.Id, m => m.Meal.Name);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Chyba při načítání menu cache: {ex.Message}");
        }

        try
        {
            var allOrders = await _apiClient.GetFromJsonAsync<OrderDto[]>("/orders");
            if (allOrders != null)
            {
                _orders = allOrders.Where(o => o.State == OrderStateDto.Preparing || o.State == OrderStateDto.Ready).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Chyba při načítání objednávek: {ex.Message}");
            _orders = new List<OrderDto>();
        }

        _ = StartSseListener();
    }

    private async Task StartSseListener()
    {
        _sseCts = new CancellationTokenSource();

        while (!_sseCts.IsCancellationRequested)
        {
            try
            {
                using var response = await _apiClient!.GetAsync("/orders/sse", HttpCompletionOption.ResponseHeadersRead, _sseCts.Token);
                using var stream = await response.Content.ReadAsStreamAsync(_sseCts.Token);
                using var reader = new System.IO.StreamReader(stream);

                _sseConnected = true;
                StateHasChanged();

                // Plně asynchronní čtení bez reader.EndOfStream pro kompatibilitu s WebAssembly
                while (!_sseCts.Token.IsCancellationRequested)
                {
                    var line = await reader.ReadLineAsync(_sseCts.Token);
                    if (line == null)
                    {
                        break; // Konec streamu
                    }

                    if (line.StartsWith("data: "))
                    {
                        var json = line.Substring(6).Trim();
                        var updatedOrder = System.Text.Json.JsonSerializer.Deserialize<OrderDto>(json, new System.Text.Json.JsonSerializerOptions
                        {
                            PropertyNameCaseInsensitive = true
                        });

                        if (updatedOrder != null)
                        {
                            await InvokeAsync(() =>
                            {
                                HandleIncomingSseEvent(updatedOrder);
                                StateHasChanged();
                            });
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"SSE odpojeno: {ex.Message}, pokus o znovupřipojení za 5 sekund...");
                _sseConnected = false;
                StateHasChanged();
                await Task.Delay(5000, _sseCts.Token);
            }
        }
    }

    private void HandleIncomingSseEvent(OrderDto updatedOrder)
    {
        if (_orders == null) return;

        var existing = _orders.FirstOrDefault(o => o.Id == updatedOrder.Id);
        
        if (updatedOrder.State == OrderStateDto.Completed || updatedOrder.State == OrderStateDto.Cancelled)
        {
            if (existing != null)
            {
                _orders.Remove(existing);
            }
        }
        else
        {
            if (existing != null)
            {
                existing.State = updatedOrder.State;
            }
            else
            {
                _orders.Add(updatedOrder);
            }
        }
    }

    private async Task UpdateState(Guid orderId, OrderStateDto newState)
    {
        try
        {
            var req = new ChangeOrderStateDto(newState);
            var response = await _apiClient!.PatchAsJsonAsync($"/orders/{orderId}/state", req);
            response.EnsureSuccessStatusCode();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Chyba při změně stavu objednávky: {ex.Message}");
        }
    }

    private string GetMealName(Guid menuItemId)
    {
        return _mealNamesCache.TryGetValue(menuItemId, out var mealName) ? mealName : "Neznámé jídlo";
    }

    private string TranslateState(OrderStateDto state) => state switch
    {
        OrderStateDto.Preparing => "Připravuje se",
        OrderStateDto.Ready => "Připraveno k vydání",
        OrderStateDto.Completed => "Vydáno",
        OrderStateDto.Cancelled => "Zrušeno",
        _ => "Neznámý stav"
    };

    private string GetBadgeClass(OrderStateDto state) => state switch
    {
        OrderStateDto.Preparing => "bg-warning text-dark",
        OrderStateDto.Ready => "bg-success text-white",
        _ => "bg-secondary"
    };

    private string GetCardBorderClass(OrderStateDto state) => state switch
    {
        OrderStateDto.Ready => "border-success",
        _ => ""
    };

    public void Dispose()
    {
        _sseCts?.Cancel();
        _sseCts?.Dispose();
    }
}