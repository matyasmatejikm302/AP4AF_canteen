@page "/canteen"
@using UTB.Minute.Contracts
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<div class="container py-4">
    <!-- Hlavička stránky -->
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-3">
        <h2 class="text-primary fw-bold">
            <span class="bi bi-funnel-fill" aria-hidden="true"></span> Jídelna UTB
        </h2>
        <div class="d-flex gap-2 align-items-center">
            <AuthorizeView>
                <Authorized>
                    <span class="badge bg-light text-dark border p-2">
                        <span class="bi bi-person-fill" aria-hidden="true"></span> @context.User.Identity?.Name
                    </span>
                </Authorized>
                <NotAuthorized>
                    <span class="badge bg-light text-muted border p-2">Anonymní student</span>
                </NotAuthorized>
            </AuthorizeView>

            @if (_sseConnected)
            {
                <span class="badge bg-success p-2">SSE: Aktivní</span>
            }
            else
            {
                <span class="badge bg-warning text-dark p-2">SSE: Připojování...</span>
            }
        </div>
    </div>

    <!-- 1. DNEŠNÍ MENU -->
    <h4 class="mb-4 text-secondary">Dnešní menu</h4>

    @if (_menuItems == null)
    {
        <div class="d-flex align-items-center">
            <strong>Načítání dnešního menu...</strong>
            <div class="spinner-border ms-auto" role="status" aria-hidden="true"></div>
        </div>
    }
    else if (!_menuItems.Any())
    {
        <div class="alert alert-info">Pro dnešní den není sestaveno žádné menu.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
            @foreach (var item in _menuItems)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm @(item.AvailablePortions <= 0 ? "border-danger opacity-75" : "")">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold">@item.Meal.Name</h5>
                                <span class="badge @(item.AvailablePortions <= 0 ? "bg-danger" : "bg-info") text-white">
                                    Skladem: @item.AvailablePortions
                                </span>
                            </div>
                            <p class="card-text text-muted small">@item.Meal.Description</p>
                            <h6 class="text-primary fw-bold mb-3">@item.Meal.Price,00 Kč</h6>
                        </div>
                        <div class="card-footer bg-white border-top-0 pb-3">
                            @if (item.AvailablePortions > 0)
                            {
                                <button class="btn btn-primary w-100 fw-bold" @onclick="() => OrderMeal(item.Id)">
                                    OBJEDNAT
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-secondary w-100 fw-bold" disabled>
                                    VYPRODÁNO
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- 2. MOJE OBJEDNÁVKY -->
    <h4 class="mb-4 text-secondary border-top pt-4">Moje objednávky</h4>

    @if (_myOrders == null)
    {
        <p class="text-muted">Načítání vašich objednávek...</p>
    }
    else if (!_myOrders.Any())
    {
        <div class="alert alert-light border">Nemáte žádné aktivní ani dokončené objednávky.</div>
    }
    else
    {
        <div class="table-responsive shadow-sm border rounded">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Číslo objednávky</th>
                        <th>Jídlo</th>
                        <th class="text-center">Stav</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in _myOrders)
                    {
                        <tr>
                            <td class="font-monospace fw-bold">#@order.Id.ToString().Substring(0, 8)</td>
                            <td>@GetMealName(order.MenuItemId)</td>
                            <td class="text-center">
                                <span class="badge @GetStateBadgeClass(order.State)">
                                    @TranslateState(order.State)
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<MenuItemDto>? _menuItems;
    private List<OrderDto>? _myOrders;
    private Dictionary<Guid, string> _mealNamesCache = new();
    private string _currentStudentId = "Student-Anonymous";
    private bool _sseConnected = false;
    private CancellationTokenSource? _sseCts;
    private HttpClient? _apiClient;

    protected override async Task OnInitializedAsync()
    {
        _apiClient = HttpClientFactory.CreateClient("webapi");

        // Zjistíme identitu přihlášeného uživatele
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // AUTOMATICKÉ PŘESMĚROVÁNÍ KUCHAŘKY:
        // Pokud je uživatel přihlášen a má roli kuchařky, okamžitě ho přesměrujeme do kuchyně
        if (user.Identity?.IsAuthenticated == true && user.IsInRole("canteen-cook"))
        {
            NavigationManager.NavigateTo("/kitchen");
            return;
        }

        _currentStudentId = user.Identity?.IsAuthenticated == true
            ? user.Identity.Name ?? "Student-Anonymous"
            : "Student-Anonymous";

        // 1. Načteme dnešní menu
        try
        {
            var menu = await _apiClient.GetFromJsonAsync<MenuItemDto[]>("/menu");
            if (menu != null)
            {
                _menuItems = menu.ToList();
                _mealNamesCache = _menuItems.ToDictionary(m => m.Id, m => m.Meal.Name);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Chyba při načítání menu: {ex.Message}");
            _menuItems = new List<MenuItemDto>();
        }

        // 2. Načteme všechny objednávky a vyfiltrujeme pouze ty, které patří tomuto studentovi
        try
        {
            var allOrders = await _apiClient.GetFromJsonAsync<OrderDto[]>("/orders");
            if (allOrders != null)
            {
                _myOrders = allOrders.Where(o => o.StudentId == _currentStudentId).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Chyba při načítání objednávek: {ex.Message}");
            _myOrders = new List<OrderDto>();
        }

        // 3. Spustíme odběr SSE streamu pro okamžitou aktualizaci změn kuchařkou
        _ = StartSseListener();
    }

    private async Task OrderMeal(Guid menuItemId)
    {
        try
        {
            var req = new CreateOrderDto(menuItemId, _currentStudentId);
            var response = await _apiClient!.PostAsJsonAsync("/orders", req);

            if (response.IsSuccessStatusCode)
            {
                var createdOrder = await response.Content.ReadFromJsonAsync<OrderDto>();
                if (createdOrder != null && _myOrders != null)
                {
                    _myOrders.Insert(0, createdOrder); // Přidáme novou objednávku navrch seznamu
                    
                    var menuItem = _menuItems?.FirstOrDefault(m => m.Id == menuItemId);
                    if (menuItem != null && menuItem.AvailablePortions > 0)
                    {
                        menuItem.AvailablePortions -= 1;
                    }
                }
            }
            else
            {
                Console.WriteLine("Chyba při objednání jídla.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Chyba při odesílání objednávky: {ex.Message}");
        }
    }

    private async Task StartSseListener()
    {
        _sseCts = new CancellationTokenSource();

        while (!_sseCts.IsCancellationRequested)
        {
            try
            {
                using var response = await _apiClient!.GetAsync("/orders/sse", HttpCompletionOption.ResponseHeadersRead, _sseCts.Token);
                using var stream = await response.Content.ReadAsStreamAsync(_sseCts.Token);
                using var reader = new System.IO.StreamReader(stream);

                _sseConnected = true;
                StateHasChanged();

                // OPRAVA PRO WEBASSEMBLY: Nepoužívat reader.EndOfStream, který provádí synchronní čtení
                while (!_sseCts.Token.IsCancellationRequested)
                {
                    var line = await reader.ReadLineAsync(_sseCts.Token);
                    if (line == null)
                    {
                        break; // Dosáhli jsme konce streamu
                    }

                    if (line.StartsWith("data: "))
                    {
                        var json = line.Substring(6).Trim();
                        var updatedOrder = System.Text.Json.JsonSerializer.Deserialize<OrderDto>(json, new System.Text.Json.JsonSerializerOptions
                        {
                            PropertyNameCaseInsensitive = true
                        });

                        if (updatedOrder != null)
                        {
                            await InvokeAsync(() =>
                            {
                                HandleIncomingSseEvent(updatedOrder);
                                StateHasChanged();
                            });
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"SSE odpojeno: {ex.Message}, pokus o znovupřipojení za 5 sekund...");
                _sseConnected = false;
                StateHasChanged();
                await Task.Delay(5000, _sseCts.Token); // Pokus o znovupřipojení
            }
        }
    }

    private void HandleIncomingSseEvent(OrderDto updatedOrder)
    {
        if (_menuItems == null || _myOrders == null) return;

        var existingOrder = _myOrders.FirstOrDefault(o => o.Id == updatedOrder.Id);
        if (existingOrder != null)
        {
            existingOrder.State = updatedOrder.State;
        }
        else if (updatedOrder.StudentId == _currentStudentId)
        {
            _myOrders.Insert(0, updatedOrder);
        }

        var menuItem = _menuItems.FirstOrDefault(m => m.Id == updatedOrder.MenuItemId);
        if (menuItem != null)
        {
            if (updatedOrder.State == OrderStateDto.Preparing && existingOrder == null)
            {
                if (menuItem.AvailablePortions > 0)
                {
                    menuItem.AvailablePortions -= 1;
                }
            }
            else if (updatedOrder.State == OrderStateDto.Cancelled)
            {
                menuItem.AvailablePortions += 1;
            }
        }
    }

    private string GetMealName(Guid menuItemId)
    {
        return _mealNamesCache.TryGetValue(menuItemId, out var name) ? name : "Neznámé jídlo";
    }

    private string TranslateState(OrderStateDto state) => state switch
    {
        OrderStateDto.Preparing => "Připravuje se",
        OrderStateDto.Ready => "Připraveno k vyzvednutí",
        OrderStateDto.Completed => "Vydáno",
        OrderStateDto.Cancelled => "Zrušeno",
        _ => "Neznámý stav"
    };

    private string GetStateBadgeClass(OrderStateDto state) => state switch
    {
        OrderStateDto.Preparing => "bg-warning text-dark",
        OrderStateDto.Ready => "bg-success text-white",
        OrderStateDto.Completed => "bg-primary text-white",
        OrderStateDto.Cancelled => "bg-danger text-white",
        _ => "bg-secondary"
    };

    public void Dispose()
    {
        _sseCts?.Cancel();
        _sseCts?.Dispose();
    }
}