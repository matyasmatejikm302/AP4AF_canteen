<!DOCTYPE html>
<html lang="cs">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <!-- Bootstrap styly z CDN, aby web vypadal moderně a přehledně -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="UTB.Minute.Web.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveWebAssembly" />
</head>

<body>
    <!-- Hlavní směrovač Blazoru s povoleným WebAssembly režimem -->
    <Routes @rendermode="InteractiveWebAssembly" />

    <!-- Skript Blazoru - spouští klientský .NET kód v prohlížeči -->
    <script src="/_framework/blazor.web.js"></script>

    <!-- Pomocný JavaScript pro Real-time aktualizace (SSE) s ochranou proti Memory Leaku -->
    <script>
        window.setupSse = (dotNetHelper, url) => {
        // --- OPRAVA CHYBY S ID '2' (Ukončení starého spojení) ---
        // Pokud v prohlížeči už běží nějaké staré spojení z předchozí stránky (např. z Jídelny),
        // okamžitě ho uzavřeme, než nastartujeme nové (např. pro Kuchyni).
        if (window.activeEventSource) {
        window.activeEventSource.close();
        console.log("Staré SSE spojení bylo bezpečně ukončeno.");
        }

        // Vytvoříme nové aktivní spojení a uložíme ho do globální proměnné
        window.activeEventSource = new EventSource(url);

        // Když přijde zpráva z backendu, pošleme ji do aktivní Blazor komponenty
        window.activeEventSource.onmessage = (event) => {
        dotNetHelper.invokeMethodAsync('OnOrderUpdate', event.data);
        };

        // Logování chyb a ukončení spojení
        window.activeEventSource.onerror = (e) => {
        console.log("SSE spojení bylo přerušeno nebo ukončeno.");
        };
        };
    </script>
</body>

</html>