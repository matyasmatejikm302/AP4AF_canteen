<!DOCTYPE html>
<html lang="cs">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <!-- Bootstrap styly z CDN pro jistotu, aby web vypadal hezky -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="UTB.Minute.Web.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveWebAssembly" />
</head>

<body>
    <!-- Hlavní směrovač Blazoru - rendermode musí být nastaven na WebAssembly -->
    <Routes @rendermode="InteractiveWebAssembly" />

    <!-- Skript Blazoru - musí zde být přesně JEDNOU -->
    <script src="/_framework/blazor.web.js"></script>

    <!-- Pomocný JavaScript pro Real-time aktualizace (SSE) -->
    <script>
        window.setupSse = (dotNetHelper, url) => {
        // Vytvoříme nové spojení na backend
        const eventSource = new EventSource(url);

        // Když přijde zpráva z backendu, pošleme ji do Blazor komponenty
        eventSource.onmessage = (event) => {
        dotNetHelper.invokeMethodAsync('OnOrderUpdate', event.data);
        };

        // Logování chyb pro snadnější ladění
        eventSource.onerror = (e) => {
        console.error("SSE spojení bylo přerušeno nebo nastala chyba:", e);
        };
        };
    </script>
</body>

</html>