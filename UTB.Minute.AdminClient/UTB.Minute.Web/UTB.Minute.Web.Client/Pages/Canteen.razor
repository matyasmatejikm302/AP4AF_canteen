@page "/canteen"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Http @* 🚀 NOVÉ: Pro streamování v prohlížeči *@
@using UTB.Minute.Contracts
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Jídelna UTB - Menu</PageTitle>

<div class="container py-4">
    <!-- Horní panel s nadpisem a statusy -->
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-3">
        <div>
            <h1 class="display-5 fw-bold text-primary m-0">Jídelna UTB</h1>
            <p class="text-muted m-0 mt-1">Dnešní čerstvá nabídka pro studenty a zaměstnance</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-secondary px-3 py-2 rounded-pill shadow-sm">student</span>
            @if (sseConnected)
            {
                <span class="badge bg-success px-3 py-2 rounded-pill shadow-sm">
                    <i class="bi bi-broadcast me-1"></i> SSE: Aktivní
                </span>
            }
            else
            {
                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm">
                    <i class="bi bi-hourglass-split me-1"></i> SSE: Připojování...
                </span>
            }
        </div>
    </div>

    <!-- Sekce: Dnešní menu -->
    <div class="mb-5">
        <h3 class="fw-bold mb-4 text-dark position-relative pb-2">
            Dnešní menu
            <span class="position-absolute bottom-0 start-0 bg-primary" style="width: 50px; height: 3px;"></span>
        </h3>

        @if (menu == null)
        {
            <div class="d-flex justify-content-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Načítání...</span>
                </div>
            </div>
        }
        else if (!menu.Any())
        {
            <div class="alert alert-info shadow-sm rounded-3">Dnes nebylo sestaveno žádné menu.</div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var item in menu)
                {
                    <div class="col">
                        <div class="card h-100 meal-card shadow-sm border-0 position-relative">
                            <!-- Badge stavu skladu -->
                            <div class="position-absolute top-0 end-0 m-3">
                                @if (item.AvailablePortions > 3)
                                {
                                    <span class="badge stock-badge-high px-3 py-1.5 rounded-pill">
                                        Skladem: @item.AvailablePortions
                                    </span>
                                }
                                else if (item.AvailablePortions > 0)
                                {
                                    <span class="badge stock-badge-low px-3 py-1.5 rounded-pill">
                                        Poslední kusy: @item.AvailablePortions
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger text-white px-3 py-1.5 rounded-pill">
                                        Vyprodáno
                                    </span>
                                }
                            </div>

                            <div class="card-body d-flex flex-column p-4 pt-5">
                                <h4 class="card-title fw-bold text-dark mb-2">@item.Meal?.Name</h4>
                                <p class="card-text text-secondary flex-grow-1 mb-4" style="font-size: 0.95rem; line-height: 1.5;">
                                    @item.Meal?.Description
                                </p>
                                
                                <div class="d-flex justify-content-between align-items-center mt-auto border-top pt-3">
                                    <span class="fs-4 fw-bold text-primary">@item.Meal?.Price.ToString("N2") Kč</span>
                                    <button class="btn btn-primary btn-order px-4 py-2"
                                            disabled="@(item.AvailablePortions <= 0)"
                                            @onclick="() => PlaceOrder(item.Id)">
                                        @if (item.AvailablePortions > 0)
                                        {
                                            <span>OBJEDNAT</span>
                                        }
                                        else
                                        {
                                            <span>NEDOSTUPNÉ</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Sekce: Moje objednávky -->
    <div class="mt-5 pt-4">
        <h3 class="fw-bold mb-4 text-dark position-relative pb-2">
            Moje objednávky
            <span class="position-absolute bottom-0 start-0 bg-primary" style="width: 50px; height: 3px;"></span>
        </h3>

        @if (myOrders == null)
        {
            <div class="d-flex justify-content-center py-4">
                <div class="spinner-border text-secondary" role="status">
                    <span class="visually-hidden">Načítání objednávek...</span>
                </div>
            </div>
        }
        else if (!myOrders.Any())
        {
            <div class="alert alert-light border shadow-sm rounded-3">Zatím jste nevytvořili žádnou objednávku.</div>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 py-3" style="width: 25%">Číslo objednávky</th>
                                <th class="py-3" style="width: 50%">Jídlo</th>
                                <th class="pe-4 py-3 text-end" style="width: 25%">Stav</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in myOrders)
                            {
                                <tr>
                                    <td class="ps-4 py-3 fw-bold text-secondary">#@order.Id.ToString().Substring(0, 8)</td>
                                    <td class="py-3 fw-semibold text-dark">@GetMealName(order.MenuItemId)</td>
                                    <td class="pe-4 py-3 text-end">
                                        <span class="badge @GetStatusBadgeClass(order.State) px-3 py-2 rounded-pill">
                                            @GetStatusTranslation(order.State)
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<MenuItemDto>? menu;
    private List<OrderDto>? myOrders;
    private bool sseConnected = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _ = ConnectToSse();
    }

    private async Task LoadData()
    {
        try
        {
            menu = await Http.GetFromJsonAsync<List<MenuItemDto>>("menu");
            myOrders = await Http.GetFromJsonAsync<List<OrderDto>>("orders");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Chyba při načítání dat: {ex.Message}");
        }
    }

    private async Task PlaceOrder(Guid menuItemId)
    {
        try
        {
            var req = new CreateOrderDto(menuItemId, "student1");
            var res = await Http.PostAsJsonAsync("orders", req);
            if (res.IsSuccessStatusCode)
            {
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Chyba při objednávání: {ex.Message}");
        }
    }

    private async Task ConnectToSse()
    {
        try
        {
            // 🚀 ÚPRAVA: Ruční sestavení požadavku a povolení streamování v prohlížeči ( fetch / WebAssembly )
            var request = new HttpRequestMessage(HttpMethod.Get, "orders/sse");
            request.SetBrowserResponseStreamingEnabled(true);

            using var response = await Http.SendAsync(request, HttpCompletionOption.ResponseHeadersRead);
            if (response.IsSuccessStatusCode)
            {
                sseConnected = true;
                StateHasChanged();

                using var stream = await response.Content.ReadAsStreamAsync();
                using var reader = new StreamReader(stream);

                while (!reader.EndOfStream)
                {
                    var line = await reader.ReadLineAsync();
                    if (!string.IsNullOrWhiteSpace(line) && line.StartsWith("data:"))
                    {
                        await InvokeAsync(async () =>
                        {
                            await LoadData();
                            StateHasChanged();
                        });
                    }
                }
            }
        }
        catch
        {
            sseConnected = false;
            StateHasChanged();
        }
    }

    private string GetMealName(Guid menuItemId)
    {
        var menuItem = menu?.FirstOrDefault(m => m.Id == menuItemId);
        return menuItem?.Meal?.Name ?? "Neznámé jídlo";
    }

    private string GetStatusBadgeClass(OrderStateDto state)
    {
        return state switch
        {
            OrderStateDto.Preparing => "bg-warning text-dark",
            OrderStateDto.Ready => "bg-info text-dark",
            OrderStateDto.Cancelled => "bg-danger text-white",
            _ => "bg-success text-white"
        };
    }

    private string GetStatusTranslation(OrderStateDto state)
    {
        return state switch
        {
            OrderStateDto.Preparing => "Připravuje se",
            OrderStateDto.Ready => "K vyzvednutí",
            OrderStateDto.Cancelled => "Zrušeno",
            _ => "Vydáno"
        };
    }
}